---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {% assign base = site.url | append: site.baseurl %}
  {% assign feed_path = site.feed.path | default: "/atom.xml" %}
  {% assign limit = site.feed.limit | default: 20 %}

  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | default: site.long_description | strip_html | strip_newlines | truncate: 220 | xml_escape }}</subtitle>

  <link href="{{ base }}{{ feed_path }}" rel="self"/>
  <link href="{{ base }}/" rel="alternate" type="text/html"/>

  {% if site.posts.first %}
    <updated>{{ site.posts.first.date | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% endif %}

  <id>{{ base }}/</id>

  <author>
    <name>{{ site.name | default: site.title | xml_escape }}</name>
    {% if site.email %}<email>{{ site.email | xml_escape }}</email>{% endif %}
  </author>

  {% if site.feed.icon %}
    <icon>{{ site.feed.icon | relative_url | prepend: base }}</icon>
  {% endif %}
  {% if site.feed.logo %}
    <logo>{{ site.feed.logo | relative_url | prepend: base }}</logo>
  {% endif %}

  <generator uri="https://jekyllrb.com/">Jekyll</generator>
  <rights>© {{ site.time | date: "%Y" }} {{ site.name | default: site.title | xml_escape }}</rights>

  {% for post in site.posts limit: limit %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link href="{{ base }}{{ post.url }}"/>
      <id>{{ base }}{{ post.id }}</id>
      <updated>{{ post.date | date_to_xmlschema }}</updated>

      {% assign summary = post.description | default: post.excerpt %}
      <summary type="html">{{ summary | strip_html | strip_newlines | truncate: 280 | xml_escape }}</summary>

      {% if post.tags %}
        {% for t in post.tags %}
          <category term="{{ t | xml_escape }}"/>
        {% endfor %}
      {% endif %}

      <content type="html">{{ post.content | xml_escape }}</content>
    </entry>
  {% endfor %}
</feed>
